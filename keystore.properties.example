# Release Keystore Configuration Template
# Copy this file to 'keystore.properties' (which is git-ignored) and fill in your real keystore details.

# Path to your keystore / jks file
# Can be relative to project root (e.g. release.keystore), relative to app (e.g. app/release.keystore), or an absolute path
storeFile=release.keystore

# Keystore password
storePassword=your_keystore_password

# Key alias
keyAlias=your_key_alias

# Key password
keyPassword=your_key_password
