<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="4dp">

    <TextView
        android:id="@+id/tv_widget_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="end"
        android:padding="2dp"
        android:maxLines="1"
        android:ellipsize="start" />
        
    <TextView
        android:id="@+id/tv_widget_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#FF9800"
        android:textSize="18sp"
        android:gravity="end"
        android:textStyle="bold"
        android:padding="2dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_c" android:text="C" android:textColor="#FF9800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_div" android:text="÷" android:textColor="#FF9800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_mul" android:text="×" android:textColor="#FF9800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_del" android:text="⌫" android:textColor="#FF9800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_7" android:text="7" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_8" android:text="8" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_9" android:text="9" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_sub" android:text="-" android:textColor="#FF9800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_4" android:text="4" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_5" android:text="5" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_6" android:text="6" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_add" android:text="+" android:textColor="#FF9800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_1" android:text="1" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_2" android:text="2" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_3" android:text="3" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_eq" android:text="=" android:textColor="#FF9800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_0" android:text="0" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="#00000000" android:textSize="14sp" />
        <Button android:id="@+id/btn_dot" android:text="." android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#00000000" android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
